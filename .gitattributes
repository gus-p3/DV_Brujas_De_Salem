# Normalización de saltos de línea para texto
* text=auto

# Archivos de texto de Unity (YAML) y código
*.cs text diff=csharp eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.md text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Archivos binarios: Git no debe intentar convertirlos ni mostrar diferencias de texto
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.bmp binary
*.exr binary
*.hdr binary
*.xcf binary
*.pdf binary
*.docx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.ttf binary
*.otf binary
*.dll binary
*.zip binary
